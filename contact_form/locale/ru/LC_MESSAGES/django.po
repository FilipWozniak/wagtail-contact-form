msgid "Full Name"
msgstr "Полное имя"

msgid "E-Mail Address"
msgstr "Адрес электронной почты"

msgid "Email Address"
msgstr "Адрес электронной почты"

msgid "Message"
msgstr "Сообщение"

msgid "Submit Form"
msgstr "Отправить форму"

msgid "We could not load the security check. Please try again."
msgstr "Не удалось загрузить проверку безопасности. Повторите попытку."

msgid "The security check expired. Please complete it again."
msgstr "Срок действия проверки безопасности истёк. Пройдите её ещё раз."

msgid "The security check timed out. Please complete it again."
msgstr "Время ожидания проверки безопасности истекло. Пройдите её ещё раз."

msgid "Please complete the CAPTCHA verification."
msgstr "Пройдите проверку CAPTCHA."

msgid "CAPTCHA verification failed. Please try again."
msgstr "Не удалось пройти проверку CAPTCHA. Повторите попытку."

msgid "The security check is temporarily unavailable. Please try again later."
msgstr "Проверка безопасности временно недоступна. Повторите попытку позже."

msgid "Leave this field empty"
msgstr "Оставьте это поле пустым"

msgid "The form is temporarily unavailable. Please try again later."
msgstr "Форма временно недоступна. Повторите попытку позже."

msgid "You submitted the form too frequently. Please wait and try again."
msgstr "Вы отправляете форму слишком часто. Подождите и повторите попытку."

msgid "We could not verify this form. Please reload the page and try again."
msgstr "Не удалось проверить эту форму. Перезагрузите страницу и повторите попытку."

msgid "Back to Home Page"
msgstr "Вернуться на главную страницу"

msgid "Thank You for Your Submission"
msgstr "Спасибо за отправку формы"
